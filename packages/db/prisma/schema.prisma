// Kiosk Platform — core schema
// Multi-tenant: every tenant row carries restaurantId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled, port 6543
  directUrl = env("DIRECT_URL")     // session pooler, port 5432 — migrations
}

// ---------------------------------------------------------------- enums

enum PlatformUserRole {
  SUPER_ADMIN
  SUPPORT
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum RestaurantUserRole {
  OWNER
  MANAGER
  STAFF
}

// ------------------------------------------------------- platform admin

/// Staff of the SaaS platform. Not tied to any restaurant.
model PlatformUser {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String           @unique
  passwordHash String
  fullName     String?
  role         PlatformUserRole @default(SUPPORT)
  isActive     Boolean          @default(true)
  lastLoginAt  DateTime?
  failedLoginCount Int             @default(0)
  lockedUntil      DateTime?
  sessions         PlatformSession[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("platform_users")
}

// ----------------------------------------------------------- tenant root

/// One tenant. Everything else hangs off this row.
model Restaurant {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Public URL segment: /r/<slug>
  slug         String           @unique
  name         String
  status       RestaurantStatus @default(ACTIVE)

  timezone     String           @default("Africa/Casablanca")
  currency     String           @default("MAD") @db.Char(3)
  locale       String           @default("fr")

  contactEmail String?
  contactPhone String?
  addressLine  String?
  city         String?
  country      String?

  /// Storage path of the logo in Supabase Storage (not a public URL).
  logoPath     String?
  primaryColor String?          @db.VarChar(9)

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  archivedAt   DateTime?

  users        RestaurantUser[]
  settings     RestaurantSettings?
  tpapi        TpapiConnection?
  orders       Order[]
  kiosks       Kiosk[]
  printers     Printer[]
  terminals    PaymentTerminal[]
  subscription Subscription?

  @@index([status])
  @@map("restaurants")
}

/// A user of one restaurant's back office. Scoped to that restaurant.
model RestaurantUser {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String             @db.Uuid
  email        String
  passwordHash String
  fullName     String?
  role         RestaurantUserRole @default(MANAGER)
  isActive     Boolean            @default(true)
  lastLoginAt  DateTime?
  failedLoginCount Int                @default(0)
  lockedUntil      DateTime?
  sessions         RestaurantSession[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  /// The same person can manage several restaurants with the same address.
  @@unique([restaurantId, email])
  @@index([restaurantId])
  @@map("restaurant_users")
}

/// Ordering and kiosk behaviour, per restaurant.
model RestaurantSettings {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId        String     @unique @db.Uuid

  eatInEnabled        Boolean    @default(true)
  takeAwayEnabled     Boolean    @default(false)
  deliveryEnabled     Boolean    @default(false)
  /// Ask zone + table for eat-in orders.
  askTableForEatIn    Boolean    @default(true)

  kioskIdleTimeoutSec Int        @default(90)
  kioskResetDelaySec  Int        @default(15)

  showAllergens       Boolean    @default(false)
  showProductImages   Boolean    @default(true)
  ticketFooterText    String?

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  restaurant          Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_settings")
}

// ------------------------------------------------------ unTill connection

/// TPAPI endpoint and credentials for one restaurant.
/// Credentials are AES-256-GCM encrypted and never leave the server.
model TpapiConnection {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId          String     @unique @db.Uuid

  host                  String
  port                  Int        @default(3063)
  useTls                Boolean    @default(false)
  wsdlPath              String     @default("/wsdl/ITPAPIPOS")
  soapPath              String     @default("/soap/ITPAPIPOS")
  /// Sent as AppName in every TPAPI request.
  appName               String     @default("KioskPlatform")

  /// Encrypted JSON: { userName, password, appToken }
  credentialsCiphertext String?
  credentialsIv         String?
  credentialsAuthTag    String?

  timeoutMs             Int        @default(15000)
  isEnabled             Boolean    @default(true)

  lastSuccessAt         DateTime?
  lastFailureAt         DateTime?
  lastErrorMessage      String?
  lastLatencyMs         Int?
  lastSyncAt            DateTime?

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  restaurant            Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("tpapi_connections")
}


// ============================================================ enums

enum PresentationScope {
  GROUP
  DEPARTMENT
}

enum OrderType {
  EAT_IN
  TAKE_AWAY
  DELIVERY
}

enum SyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum SyncTrigger {
  MANUAL
  SCHEDULED
  STARTUP
}

// ======================================== TPAPI MIRROR (overwritten by sync)
// Rows reference each other by unTill ID, never by database FK.

model TpapiSalesArea {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String   @db.Uuid
  untillId     BigInt
  number       Int
  name         String
  priceLevelId BigInt?
  /// TTableRange[]: [{ fromTable, toTable }]
  tableRanges  Json     @default("[]")
  isActive     Boolean  @default(true)
  syncedAt     DateTime @default(now())

  @@unique([restaurantId, untillId])
  @@index([restaurantId])
  @@map("tpapi_sales_areas")
}

model TpapiPriceLevel {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String   @db.Uuid
  untillId     BigInt
  name         String
  hqId         String?
  syncedAt     DateTime @default(now())

  @@unique([restaurantId, untillId])
  @@index([restaurantId])
  @@map("tpapi_price_levels")
}

model TpapiCategory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String   @db.Uuid
  untillId     BigInt
  name         String
  hqId         String?
  syncedAt     DateTime @default(now())

  @@unique([restaurantId, untillId])
  @@index([restaurantId])
  @@map("tpapi_categories")
}

model TpapiGroup {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String   @db.Uuid
  untillId     BigInt
  name         String
  categoryId   BigInt?
  hqId         String?
  syncedAt     DateTime @default(now())

  @@unique([restaurantId, untillId])
  @@index([restaurantId])
  @@map("tpapi_groups")
}

model TpapiDepartment {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId          String   @db.Uuid
  untillId              BigInt
  number                Int
  name                  String
  groupId               BigInt?
  /// Option group applied to every article of this department.
  supplementOptionId    BigInt?
  condimentOptionId     BigInt?
  availableSalesAreaIds BigInt[]
  hqId                  String?
  syncedAt              DateTime @default(now())

  @@unique([restaurantId, untillId])
  @@index([restaurantId])
  @@map("tpapi_departments")
}

model TpapiArticle {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId          String   @db.Uuid
  untillId              BigInt
  number                Int
  name                  String
  departmentId          BigInt?
  availableSalesAreaIds BigInt[]

  /// No price rows at all = menu; price comes from the chosen option items.
  isMenu                Boolean  @default(false)
  isManualPrice         Boolean  @default(false)
  isActive              Boolean  @default(true)
  promo                 Boolean  @default(false)

  /// From Extra
  plu                   String?
  courseId              BigInt?
  sizeModifierId        BigInt?
  externalId            String?
  hqId                  String?
  /// Whole Extra array, for keys we have not decoded yet.
  rawExtra              Json     @default("[]")

  /// Set to false when a sync no longer returns this article.
  isPresent             Boolean  @default(true)
  syncedAt              DateTime @default(now())

  @@unique([restaurantId, untillId])
  @@index([restaurantId, departmentId])
  @@index([restaurantId, isPresent])
  @@map("tpapi_articles")
}

model TpapiArticlePrice {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String   @db.Uuid
  articleId    BigInt
  priceLevelId BigInt
  amount       Decimal  @db.Decimal(12, 4)
  vat          Decimal  @db.Decimal(6, 3)
  syncedAt     DateTime @default(now())

  @@unique([restaurantId, articleId, priceLevelId])
  @@index([restaurantId, articleId])
  @@map("tpapi_article_prices")
}

/// Price per size, read from Prices[].Extra["size_modifiers"].
model TpapiArticleSizePrice {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String   @db.Uuid
  articleId    BigInt
  priceLevelId BigInt
  sizeItemId   BigInt
  amount       Decimal  @db.Decimal(12, 4)
  syncedAt     DateTime @default(now())

  @@unique([restaurantId, articleId, priceLevelId, sizeItemId])
  @@index([restaurantId, articleId])
  @@map("tpapi_article_size_prices")
}

/// article → option group, with the "choose N" rule from composed_options.
model TpapiArticleOption {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId    String   @db.Uuid
  articleId       BigInt
  optionGroupId   BigInt
  /// From composed_options "<optionGroupId>:<n>". Null = free choice.
  requiredChoices Int?
  /// True when this group is the article's FreeOption.
  isFreeOption    Boolean  @default(false)
  sortOrder       Int      @default(0)
  syncedAt        DateTime @default(now())

  @@unique([restaurantId, articleId, optionGroupId])
  @@index([restaurantId, articleId])
  @@map("tpapi_article_options")
}

model TpapiOptionGroup {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId          String   @db.Uuid
  untillId              BigInt
  name                  String
  availableSalesAreaIds BigInt[]
  /// Groups with no items are skipped by the kiosk.
  itemCount             Int      @default(0)
  syncedAt              DateTime @default(now())

  @@unique([restaurantId, untillId])
  @@index([restaurantId])
  @@map("tpapi_option_groups")
}

/// One choice inside an option group. It is itself an article.
model TpapiOptionItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId  String   @db.Uuid
  optionGroupId BigInt
  articleId     BigInt
  priceLevelId  BigInt
  amount        Decimal  @db.Decimal(12, 4)
  vat           Decimal  @db.Decimal(6, 3)
  syncedAt      DateTime @default(now())

  @@unique([restaurantId, optionGroupId, articleId, priceLevelId])
  @@index([restaurantId, optionGroupId])
  @@map("tpapi_option_items")
}

model TpapiSizeModifier {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String   @db.Uuid
  untillId     BigInt
  number       Int
  name         String
  isActive     Boolean  @default(true)
  syncedAt     DateTime @default(now())

  @@unique([restaurantId, untillId])
  @@index([restaurantId])
  @@map("tpapi_size_modifiers")
}

model TpapiSizeModifierItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId    String   @db.Uuid
  untillId        BigInt
  sizeModifierId  BigInt
  number          Int
  name            String
  isActive        Boolean  @default(true)
  syncedAt        DateTime @default(now())

  @@unique([restaurantId, untillId])
  @@index([restaurantId, sizeModifierId])
  @@map("tpapi_size_modifier_items")
}

model TpapiCourse {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String   @db.Uuid
  untillId     BigInt
  number       Int
  name         String
  separate     Boolean  @default(false)
  autoFire     Boolean  @default(false)
  syncedAt     DateTime @default(now())

  @@unique([restaurantId, untillId])
  @@index([restaurantId])
  @@map("tpapi_courses")
}

model TpapiPayment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String   @db.Uuid
  untillId     BigInt
  number       Int
  name         String
  kind         Int
  syncedAt     DateTime @default(now())

  @@unique([restaurantId, untillId])
  @@index([restaurantId])
  @@map("tpapi_payments")
}

model TpapiPrinter {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String   @db.Uuid
  untillId     BigInt
  name         String
  guid         String?
  nullPrinter  Boolean  @default(false)
  syncedAt     DateTime @default(now())

  @@unique([restaurantId, untillId])
  @@index([restaurantId])
  @@map("tpapi_printers")
}

model TpapiAllergen {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String   @db.Uuid
  untillId     BigInt
  number       Int
  name         String
  description  String?
  isActive     Boolean  @default(true)
  syncedAt     DateTime @default(now())

  @@unique([restaurantId, untillId])
  @@index([restaurantId])
  @@map("tpapi_allergens")
}

// ============================ LOCAL PRESENTATION (never written by sync)

/// Commercial layer over a TPAPI article.
model ProductPresentation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String   @db.Uuid
  /// unTill ArticleId. No FK: the article may be re-created by a later sync.
  articleId    BigInt

   /// { "fr": "…", "en": "…", "ar": "…" }. A new language is data, not a migration.
  displayName  Json?
  description  Json?
  /// Path in Supabase Storage, not a public URL.
  imagePath    String?
  isVisible    Boolean  @default(true)
  sortOrder    Int      @default(0)
  isFeatured   Boolean  @default(false)
  badgeText    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([restaurantId, articleId])
  @@index([restaurantId, isVisible])
  @@map("product_presentations")
}

/// Commercial layer over a group or a department.
model CategoryPresentation {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String            @db.Uuid
  scope        PresentationScope
  /// unTill GroupId or DepartmentId, depending on scope.
  untillId     BigInt

    /// { "fr": "…", "en": "…", "ar": "…" }
  displayName  Json?
  description  Json?
  imagePath    String?
  color        String?           @db.VarChar(9)
  isVisible    Boolean           @default(true)
  sortOrder    Int               @default(0)

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([restaurantId, scope, untillId])
  @@index([restaurantId, scope])
  @@map("category_presentations")
}

/// TPAPI has no article→allergen link, so it is declared here.
model ProductAllergen {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String   @db.Uuid
  articleId    BigInt
  allergenId   BigInt
  createdAt    DateTime @default(now())

  @@unique([restaurantId, articleId, allergenId])
  @@index([restaurantId, articleId])
  @@map("product_allergens")
}

// ==================================================== ordering configuration

/// Maps an order type to a sales area and its table strategy,
/// because CreateOrder has no order-type field.
model OrderTypeMapping {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId   String    @db.Uuid
  orderType      OrderType
  salesAreaId    BigInt
  /// EAT_IN: customer picks a table inside the area's ranges.
  /// TAKE_AWAY / DELIVERY: a fixed table, or a range we allocate from.
  fixedTableNumber Int?
  tableRangeFrom   Int?
  tableRangeTo     Int?
  tablePart        String?
  isEnabled        Boolean @default(true)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([restaurantId, orderType])
  @@index([restaurantId])
  @@map("order_type_mappings")
}

// ================================================================ sync runs

model SyncRun {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId  String      @db.Uuid
  status        SyncStatus  @default(RUNNING)
  trigger       SyncTrigger @default(MANUAL)
  correlationId String
  startedAt     DateTime    @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  /// Row counts per entity, plus anomalies.
  stats         Json        @default("{}")
  errorMessage  String?

  @@index([restaurantId, startedAt])
  @@map("sync_runs")
}
// ================================================================== orders

enum OrderStatus {
  /// Being built, not yet submitted. Cleaned up automatically.
  DRAFT
  /// Validated and priced by the backend, queued for TPAPI.
  PENDING
  /// CreateOrder returned ReturnCode 0.
  SENT
  /// Found in GetActiveOrders by OrderName — genuinely open in unTill.
  CONFIRMED
  /// No longer in GetActiveOrders: the till closed it. Inferred, not reported.
  PAID
  /// CreateOrder failed, or verification never succeeded.
  FAILED
  /// Abandoned at the kiosk, or cancelled by staff.
  CANCELLED
}

enum PaymentMethod {
  PAY_AT_CASHIER
  PAYMENT_TERMINAL
}

/// What a line represents for us. Mapped to unTill's OrderItemType at send time.
enum OrderItemKind {
  PRODUCT
  SIZE
  OPTION
  SUPPLEMENT
  MENU_CHOICE
  REMOVAL
  TEXT
}

enum OrderActor {
  KIOSK
  SYSTEM
  RESTAURANT_USER
  PLATFORM_USER
}

model Order {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId   String        @db.Uuid
  kioskId        String?       @db.Uuid

  /// Sent to unTill as OrderName and printed on the ticket. Max 20 chars.
  reference      String        @db.VarChar(20)
  /// Idempotency key generated by the kiosk when the cart is created.
  clientRequestId String?      @db.Uuid
  /// Trading day, for daily numbering and reporting (not always the calendar day).
  businessDate   DateTime      @db.Date
  dailySequence  Int

  orderType      OrderType
  status         OrderStatus   @default(DRAFT)
  paymentMethod  PaymentMethod @default(PAY_AT_CASHIER)

  /// Resolved unTill targets at order time.
  salesAreaId    BigInt
  tableNumber    Int
  tablePart      String        @default("")
  priceLevelId   BigInt
  covers         Int           @default(1)

  currency       String        @db.Char(3)
  subtotal       Decimal       @db.Decimal(12, 4)
  taxTotal       Decimal       @db.Decimal(12, 4)
  total          Decimal       @db.Decimal(12, 4)
  itemCount      Int           @default(0)

  /// Optional, for takeaway call-out. Keep empty unless the restaurant needs it.
  customerName   String?
  customerNote   String?

  // --- TPAPI submission ---
  tpapiAttempts       Int       @default(0)
  tpapiCorrelationId  String?
  tpapiReturnCode     Int?
  tpapiLastError      String?
  /// Exactly what we sent, for support and replay. No credentials.
  tpapiRequestSnapshot Json?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sentAt         DateTime?
  confirmedAt    DateTime?
  paidDetectedAt DateTime?
  failedAt       DateTime?
  cancelledAt    DateTime?

  restaurant     Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  kiosk          Kiosk?               @relation(fields: [kioskId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  history        OrderStatusHistory[]

  @@unique([restaurantId, reference])
  @@unique([restaurantId, clientRequestId])
  @@unique([restaurantId, businessDate, dailySequence])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, status])
  @@index([restaurantId, businessDate])
  @@map("orders")
}

/// Flat line list, shaped like TPAPI's Items[]. Modifiers point at their parent.
model OrderItem {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId             String        @db.Uuid
  /// Denormalised so tenant-scoped queries never need a join.
  restaurantId        String        @db.Uuid

  /// Sent as ItemNumber. Sequential from 1 within the order.
  lineNumber          Int
  /// Line number of the product this modifier belongs to. Null for products.
  parentLineNumber    Int?
  kind                OrderItemKind @default(PRODUCT)

  articleId           BigInt?
  /// Snapshots — a later sync must never rewrite history.
  articleName         String
  displayName         String?

  quantity            Int           @default(1)
  unitPrice           Decimal       @db.Decimal(12, 4)
  lineTotal           Decimal       @db.Decimal(12, 4)
  vatRate             Decimal?      @db.Decimal(6, 3)

  /// Set when the price came from a size.
  sizeItemId          BigInt?
  sizeName            String?
  /// Set for OPTION, SUPPLEMENT and MENU_CHOICE lines.
  optionGroupId       BigInt?
  optionGroupName     String?

  /// Sent as Text (free text, removals).
  text                String?
  /// unTill's OrderItemType. Filled in once unTill gives us the values.
  untillOrderItemType Int?

  createdAt           DateTime      @default(now())

  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, lineNumber])
  @@index([orderId])
  @@index([restaurantId, articleId])
  @@map("order_items")
}

model OrderStatusHistory {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String      @db.Uuid
  restaurantId String      @db.Uuid

  fromStatus   OrderStatus?
  toStatus     OrderStatus
  actor        OrderActor  @default(SYSTEM)
  /// Restaurant user or platform user id, when a person did it.
  actorId      String?     @db.Uuid
  reason       String?
  meta         Json        @default("{}")
  createdAt    DateTime    @default(now())

  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([restaurantId, createdAt])
  @@map("order_status_history")
}

/// Atomic daily counter, so two kiosks never produce the same reference.
model OrderCounter {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId  String   @db.Uuid
  businessDate  DateTime @db.Date
  lastSequence  Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([restaurantId, businessDate])
  @@map("order_counters")
}

// ================================================================= devices

enum DeviceKind {
  KIOSK
  PRINTER
  PAYMENT_TERMINAL
}

enum DeviceStatus {
  PROVISIONING
  ONLINE
  OFFLINE
  DISABLED
}

enum PrinterKind {
  RECEIPT
  KITCHEN
  LABEL
}

enum PrinterConnection {
  NETWORK
  USB
  SERIAL
  BLUETOOTH
  UNTILL
}

enum DeviceEventType {
  CREATED
  CONNECTED
  DISCONNECTED
  HEARTBEAT_MISSED
  CONFIG_CHANGED
  SOFTWARE_UPDATED
  ERROR
  RECOVERED
}

model Kiosk {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId     String       @db.Uuid

  /// Short code used in order references, e.g. "K1" in K1-0923-042.
  code             String       @db.VarChar(4)
  name             String
  status           DeviceStatus @default(PROVISIONING)
  isEnabled        Boolean      @default(true)

  /// SHA-256 of the device token. The plaintext is shown once, at provisioning.
  tokenHash        String?      @unique
  tokenIssuedAt    DateTime?
  tokenRevokedAt   DateTime?

  /// Optional override of the restaurant's default sales area.
  salesAreaId      BigInt?
  defaultOrderType OrderType?

  appVersion       String?
  lastHeartbeatAt  DateTime?
  lastActivityAt   DateTime?
  lastIpAddress    String?
  /// Screen settings, language, idle timeout overrides.
  config           Json         @default("{}")

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  restaurant       Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  printers         Printer[]
  terminals        PaymentTerminal[]
  orders           Order[]

  @@unique([restaurantId, code])
  @@index([restaurantId, status])
  @@map("kiosks")
}

model Printer {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId     String            @db.Uuid
  kioskId          String?           @db.Uuid

  name             String
  kind             PrinterKind       @default(RECEIPT)
  connection       PrinterConnection @default(NETWORK)
  /// IP, hostname or device path, depending on connection.
  address          String?
  port             Int?
  /// Set when this is an unTill printer from GetPrintersInfo.
  untillPrinterId  BigInt?

  status           DeviceStatus      @default(PROVISIONING)
  isEnabled        Boolean           @default(true)
  lastSeenAt       DateTime?
  lastErrorAt      DateTime?
  lastErrorMessage String?
  config           Json              @default("{}")

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  restaurant       Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  kiosk            Kiosk?            @relation(fields: [kioskId], references: [id], onDelete: SetNull)

  @@index([restaurantId, status])
  @@index([kioskId])
  @@map("printers")
}

model PaymentTerminal {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId     String       @db.Uuid
  kioskId          String?      @db.Uuid

  name             String
  /// Free text until a real terminal API is chosen. Nothing invented here.
  provider         String?
  serialNumber     String?
  status           DeviceStatus @default(PROVISIONING)
  isEnabled        Boolean      @default(false)
  lastSeenAt       DateTime?
  lastErrorAt      DateTime?
  lastErrorMessage String?
  config           Json         @default("{}")

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  restaurant       Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  kiosk            Kiosk?       @relation(fields: [kioskId], references: [id], onDelete: SetNull)

  @@index([restaurantId, status])
  @@map("payment_terminals")
}

/// One timeline for every device type. No FK: deviceId points at whichever table deviceKind names.
model DeviceEvent {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String          @db.Uuid
  deviceKind   DeviceKind
  deviceId     String          @db.Uuid
  type         DeviceEventType
  message      String?
  meta         Json            @default("{}")
  createdAt    DateTime        @default(now())

  @@index([restaurantId, createdAt])
  @@index([deviceKind, deviceId, createdAt])
  @@map("device_events")
}

// ==================================================================== logs

enum IntegrationKind {
  TPAPI
  PRINTER
  PAYMENT_TERMINAL
  KIOSK
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

/// One row per external call. Never contains credentials.
model IntegrationLog {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId    String          @db.Uuid
  kind            IntegrationKind @default(TPAPI)
  /// TPAPI operation name, or the action for other kinds.
  operation       String?
  correlationId   String
  level           LogLevel        @default(INFO)
  ok              Boolean         @default(true)

  httpStatus      Int?
  returnCode      Int?
  message         String?
  durationMs      Int?

  /// Summaries, not full payloads. Passwords are redacted before writing.
  requestSummary  Json?
  responseSummary Json?

  orderId         String?         @db.Uuid
  kioskId         String?         @db.Uuid
  createdAt       DateTime        @default(now())

  @@index([restaurantId, createdAt])
  @@index([restaurantId, ok, createdAt])
  @@index([correlationId])
  @@index([orderId])
  @@map("integration_logs")
}

enum AuditActorType {
  PLATFORM_USER
  RESTAURANT_USER
  SYSTEM
  KIOSK
}

/// Who changed what. restaurantId is null for platform-wide actions.
model AuditLog {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String?        @db.Uuid
  actorType    AuditActorType @default(SYSTEM)
  actorId      String?        @db.Uuid
  actorLabel   String?

  /// e.g. "restaurant.update", "kiosk.token.rotate", "tpapi.credentials.update"
  action       String
  entityType   String
  entityId     String?
  before       Json?
  after        Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime       @default(now())

  @@index([restaurantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// =========================================================== subscriptions

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

model Subscription {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId       String             @unique @db.Uuid

  plan               String             @default("standard")
  status             SubscriptionStatus @default(TRIALING)
  startedAt          DateTime           @default(now())
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?

  /// Limits enforced by the API. Null = unlimited.
  maxKiosks          Int?
  maxOrdersPerMonth  Int?
  /// Feature flags, e.g. { "delivery": true, "paymentTerminal": false }
  features           Json               @default("{}")
  notes              String?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  restaurant         Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("subscriptions")
}
/// One refresh-token session for a platform user. The token itself is never stored.
model PlatformSession {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String       @db.Uuid
  /// SHA-256 of the refresh token.
  tokenHash    String       @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Set when this session was rotated into a new one.
  replacedById String?      @db.Uuid
  lastUsedAt   DateTime?
  createdAt    DateTime     @default(now())

  user         PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("platform_sessions")
}


/// Refresh-token session for a restaurant back-office user.
model RestaurantSession {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String         @db.Uuid
  userId       String         @db.Uuid
  tokenHash    String         @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?        @db.Uuid
  lastUsedAt   DateTime?
  createdAt    DateTime       @default(now())

  user         RestaurantUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId, userId])
  @@index([userId, expiresAt])
  @@map("restaurant_sessions")
}