# ---- Supabase Postgres ----
# Runtime connection (transaction pooler, port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<DB_PASSWORD_URL_ENCODED>@aws-<n>-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations connection (session pooler, port 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<DB_PASSWORD_URL_ENCODED>@aws-<n>-<region>.pooler.supabase.com:5432/postgres"

# ---- Supabase API (SERVER ONLY — never expose to the browser) ----
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_xxx"

# ---- unTill TPAPI (discovery / testing only) ----
TPAPI_WSDL_URL="http://testapi.untill.com:3063/wsdl/ITPAPIPOS"
# ---- unTill TPAPI ----
TPAPI_WSDL_URL="http://testapi.untill.com:3063/wsdl/ITPAPIPOS"
TPAPI_ENDPOINT="http://testapi.untill.com:3063/soap/ITPAPIPOS"
TPAPI_USERNAME=""
TPAPI_PASSWORD=""
TPAPI_APPTOKEN=""
TPAPI_APPNAME="KioskPlatform"
TPAPI_DEBUG_XML="1"