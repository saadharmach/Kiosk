# ---- Supabase Postgres ----
# Runtime connection (transaction pooler, port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<DB_PASSWORD_URL_ENCODED>@aws-<n>-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations connection (session pooler, port 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<DB_PASSWORD_URL_ENCODED>@aws-<n>-<region>.pooler.supabase.com:5432/postgres"

# ---- Supabase API (SERVER ONLY — never expose to the browser) ----
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_xxx"

# ---- unTill TPAPI (discovery / testing only) ----
TPAPI_WSDL_URL="http://testapi.untill.com:3063/wsdl/ITPAPIPOS"
# ---- unTill TPAPI ----
TPAPI_WSDL_URL="http://testapi.untill.com:3063/wsdl/ITPAPIPOS"
TPAPI_ENDPOINT="http://testapi.untill.com:3063/soap/ITPAPIPOS"
TPAPI_USERNAME=""
TPAPI_PASSWORD=""
TPAPI_APPTOKEN=""
TPAPI_APPNAME="KioskPlatform"
TPAPI_DEBUG_XML="1"

JWT_SECRET="replace_me_with_64_hex_chars"
ACCESS_TOKEN_TTL_MIN="15"
REFRESH_TOKEN_TTL_DAYS="30"


# 32 bytes as 64 hex chars — AES-256-GCM key for TPAPI credentials
ENCRYPTION_KEY="paste_the_64_hex_chars_here"
ENCRYPTION_KEY="replace_with_64_hex_chars"

# Automatic menu sync: minutes between reads of each restaurant's menu from its till (0 turns it off),
# and the first retry delay after a failure (it doubles each time, up to the interval).
# CATALOG_SYNC_INTERVAL_MIN=60
# CATALOG_SYNC_RETRY_MIN=15

# New accounts need a real email address (placeholders and non-existent domains are refused). Set to off on a machine
# with no internet. Existing accounts are never re-checked.
# EMAIL_CHECK=on

# ---- Email (invitations and password resets) ----
# Any provider that offers SMTP works (Resend, Postmark, Brevo, Gmail, your own server). With SMTP_HOST unset, a development
# machine writes each email to the API log instead of sending it, and a PRODUCTION server refuses to send.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587            # 465 for TLS from the first byte (then SMTP_SECURE=true)
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Kiosk Platform <no-reply@yourdomain.com>"
# Where the links in those emails lead (the address people really use, not localhost, in production):
# ADMIN_APP_URL=http://localhost:3004
# BACKOFFICE_APP_URL=http://localhost:3003
# Public address of the kiosk app: used to show each borne's link (…/r/<slug>?borne=K1) in the back office.
# KIOSK_APP_URL=http://localhost:3002
